<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_zid_config_customer_form" model="ir.ui.view">
        <field name="name">view.zid.config.form</field>
        <field name="model">zid.config</field>
        <field name="inherit_id" ref="sh_zid_connector.view_zid_config_form" />
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page name="customer" string="Customer">
                    <group>
                        <group>
                            <field name="import_customer" />
                            <field name="manage_log_customer" string="Manage Log History" />
                            <button type="object" class="btn btn-primary mx-2" name="get_customers" string="Sync Customers" />
                        </group>
                        <group>
                            <field name="last_sync_customer" readonly="1" />
                            <!-- <field name="export_customer" /> -->
                        </group>
                    </group>
                    <!-- <h3 class="text-primary">Auto Schedule</h3>
                    <group>
                        <field name="auto_import_customer" string="Auto Import" />
                        <field name="auto_export_customer" string="Auto Export" />
                    </group> -->
                </page>
            </xpath>
        </field>
    </record>
</odoo>