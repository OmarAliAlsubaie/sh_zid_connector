<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_zid_config_product_form" model="ir.ui.view">
        <field name="name">view.zid.config.form</field>
        <field name="model">zid.config</field>
        <field name="inherit_id" ref="sh_zid_connector.view_zid_config_form" />
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page name="product" string="Product">
                    <group>
                        <group>
                            <field name="import_product" />
                            <field name="sync_image" />
                            <field name="manage_log_product" string="Manage Log History" />
                            <field name="next_product_url" invisible="1" />
                            <field name="sh_import_based_on_date" string="Import based on date" />
                            <!-- <field name="sh_from_date" string="Default Warehouse" attrs="{'invisible': [('sh_import_based_on_date', '=', False)],'required': [('sh_import_based_on_date', '=', True)]}" /> -->
                            <field name="sh_from_date" string="From Date" invisible="not sh_import_based_on_date" required="sh_import_based_on_date" />
                            <!-- <field name="sh_to_date" string="To Date" attrs="{'invisible': [('sh_import_based_on_date', '=', False)],'required': [('sh_import_based_on_date', '=', True)]}" /> -->
                            <field name="sh_to_date" string="To Date" invisible="not sh_import_based_on_date" required="sh_import_based_on_date" />
                            <button type="object" class="btn btn-primary mt-2" name="get_products" string="Sync Products" />
                        </group>
                        <group>
                            <field name="last_sync_product" readonly="1" />
                            <field name="sh_not_update_product" />
                            <field name="sh_default_category" />
                            <field name="sh_default_warehouse" />
                            <!-- <field name="export_product" /> -->
                        </group>
                    </group>
                    <!-- <h3 class="text-primary">Auto Schedule</h3>
                    <group>
                        <field name="auto_import_product" string="Auto Import" />
                        <field name="auto_export_product" string="Auto Export" />
                    </group> -->

                </page>
            </xpath>
        </field>
    </record>
</odoo>