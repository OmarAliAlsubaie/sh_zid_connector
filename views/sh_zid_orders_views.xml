<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_zid_config_order_form" model="ir.ui.view">
        <field name="name">view.zid.config.form</field>
        <field name="model">zid.config</field>
        <field name="inherit_id" ref="sh_zid_connector.view_zid_config_form" />
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page name="order" string="Orders">
                    <group>
                        <group>
                            <field name="import_order" />
                            <field name="sh_zid_id_appear_in_order" />
                            <field name="manage_log_order" />
                            <field name="manage_log_basic" />
                            <button type="action" class="btn btn-primary mt-2" name="%(sh_zid_connector.sh_zid_import_order_wizard_action)d" string="Sync Orders" />
                        </group>
                        <group>
                            <field name="last_sync_order" readonly="1" />
                            <field name="discount_product" required="1" />
                            <field name="delivery_warehosue" />
                        </group>
                    </group>
                    <h3 class="text-primary">Auto Schedule</h3>
                    <group>
                        <group>
                            <field name="auto_import_order" string="Auto Import" />
                        </group>
                        <group>
                            <field
                                name="sh_zid_stage_ids"
                                widget="many2many_tags"
                                required="auto_import_order"
                                invisible="not auto_import_order"
                                options="{'no_create': True}"
                            />
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>