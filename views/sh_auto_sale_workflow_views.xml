<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="sh_auto_sale_workflow_view_form_zid" model="ir.ui.view">
        <field name="name">sh.auto.sale.workflow.view.form</field>
        <field name="model">sh.auto.sale.workflow</field>
        <field name="arch" type="xml">
            <form string="">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" required="1" default_focus="1" placeholder="Name" />
                        </h1>
                    </div>
                    <group>
                        <group string="Workflow Option">
                            <field name="validate_order" />
                            <!-- <field name="force_transfer" attrs="{'invisible':[('validate_order', '=', False)]}" /> -->
                            <field name="force_transfer" invisible="not validate_order" />
                            <field name="create_invoice" />
                            <!-- <field name="validate_invoice" attrs="{'invisible':[('create_invoice', '=', False)]}" /> -->
                            <field name="validate_invoice" invisible="not create_invoice" />
                            <!-- <field name="register_payment" attrs="{'invisible':['|',('create_invoice', '=', False),('validate_invoice', '=', False)]}" /> -->
                            <field name="register_payment" invisible="(not create_invoice) or (not validate_invoice)" />
                            <!-- <field name="register_payment" attrs="{'invisible':['|',('create_invoice', '=', False),('validate_invoice', '=', False)]}" /> -->
                            <field name="register_payment" invisible="(not create_invoice) or (not validate_invoice)" />
                            <!-- <field name="send_invoice_by_email" attrs="{'invisible':['|',('create_invoice', '=', False),('validate_invoice', '=', False)]}" /> -->
                            <field name="send_invoice_by_email" invisible="(not create_invoice) or (not validate_invoice)" />
                        </group>
                        <group>
                            <field name="zid_order_state" />
                            <!-- <field name="sale_journal" attrs="{'invisible':[('create_invoice', '=', False)],'required':[('create_invoice','=',True)]}" domain="[('type','=','sale')]" options="{'no_create': True, 'no_create_edit':True}" /> -->
                            <field name="sale_journal" invisible="not create_invoice" required="create_invoice" domain="[('type','=','sale')]" options="{'no_create': True, 'no_create_edit':True}" />
                            <!-- <field name="payment_journal" attrs="{'invisible':['|','|',('create_invoice', '=', False),('validate_invoice', '=', False),('register_payment', '=', False)],'required':[('create_invoice','=',True),('validate_invoice', '=', True),('register_payment', '=', True)]}" domain="[('type', 'in', ('bank', 'cash'))]" options="{'no_create': True, 'no_create_edit':True}" /> -->
                            <field name="payment_journal" invisible="(not create_invoice) or (not validate_invoice) or (not register_payment)" required="create_invoice and validate_invoice and register_payment" domain="[('type', 'in', ('bank', 'cash'))]" options="{'no_create': True, 'no_create_edit':True}" />
                            <!-- <field name="payment_method" attrs="{'invisible':['|','|',('create_invoice', '=', False),('validate_invoice', '=', False),('register_payment', '=', False)],'required':[('create_invoice','=',True),('validate_invoice', '=', True),('register_payment', '=', True)]}" domain="[('payment_type', '=', 'inbound')]" /> -->
                            <field name="payment_method" invisible="(not create_invoice) or (not validate_invoice) or (not register_payment)" required="create_invoice and validate_invoice and register_payment" domain="[('payment_type', '=', 'inbound')]" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sh_auto_sale_workflow_view_tree_zid" model="ir.ui.view">
        <field name="name">sh.auto.sale.workflow.view.tree</field>
        <field name="model">sh.auto.sale.workflow</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" optional="show" />
                <field name="validate_order" optional="show" widget="boolean_toggle" />
                <field name="force_transfer" optional="show" widget="boolean_toggle" />
                <field name="create_invoice" optional="show" widget="boolean_toggle" />
                <field name="validate_invoice" optional="show" widget="boolean_toggle" />
                <field name="register_payment" optional="show" widget="boolean_toggle" />
                <field name="send_invoice_by_email" optional="show" widget="boolean_toggle" />
                <field name="sale_journal" optional="show" />
                <field name="payment_journal" optional="show" />
            </list>
        </field>
    </record>

    <record id="sh_auto_sale_workflow_action_zid" model="ir.actions.act_window">
        <field name="name">Auto Sales Workflow</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sh.auto.sale.workflow</field>
        <field name="view_mode">list,form</field>
    </record>


</odoo>