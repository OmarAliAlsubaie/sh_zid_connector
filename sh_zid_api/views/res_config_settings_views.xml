    <!-- Auto Sale Workflow Settings -->
    <record id="sh_sale_res_config_settings_view_form" model="ir.ui.view">
        <field name="name">Auto Sale Workflow Settings</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//app[@name='sale_management']//block[@name='catalog_setting_container']" position="after">
                <block title="Auto Sale Workflow Settings" name="sh_zid_auto_sale_workflow">
                    <setting id="sh_field_auto_sale_workflow">
                        <field name="group_auto_sale_workflow"/>
                    </setting>
                    <setting id="sh_field_workflow_id">
                        <field name="workflow_id"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>