<odoo>

    <!-- =========================== TREE VIEW =========================== -->

    <!-- CUSTOMER -->
    <record id='sh_zid_customer_tree' model='ir.ui.view'>
        <field name="name">sh.zid.customer.tree</field>
        <field name="model">sh.zid.queue</field>
        <field name="arch" type="xml">
            <list decoration-success="sh_current_state=='done'" decoration-danger="sh_current_state=='error'">
                <field name="sh_queue_name" />
                <field name="sh_customer_id" />
                <field name="queue_sync_date" />
                <field name="sh_current_state" />
                <field name="sh_note" />
            </list>
        </field>
    </record>

<record id="sh_zid_customer_view_form" model="ir.ui.view">
    <field name="name">sh.zid.customer.view.form</field>
    <field name="model">sh.zid.queue</field>
    <field name="arch" type="xml">
        <form>
            <sheet>
                <group>
                    <group>
                        <field name="queue_type" readonly="1"/>
                        <field name="sh_customer_id" readonly="1"/>
                        <field name="sh_order_id" readonly="1"/>
                        <field name="sh_note" readonly="1"/>
                        <field name="queue_sync_date" readonly="1"/>
                        <field name="sh_current_state" readonly="1"/>
                    </group>
                    <group>
                        <field name="sh_queue_name" readonly="1"/>
                        <field name="sh_product_id" readonly="1"/>
                        <field name="sh_current_config" readonly="1" />
                    </group>
                </group>
            </sheet>
        </form>
    </field>
</record>



    <!-- PRODUCT -->
    <record id='sh_zid_product_tree' model='ir.ui.view'>
        <field name="name">sh.zid.product.tree</field>
        <field name="model">sh.zid.queue</field>
        <field name="arch" type="xml">
            <list decoration-success="sh_current_state=='done'" decoration-danger="sh_current_state=='error'">
                <field name="sh_queue_name" />
                <field name="sh_product_id" />
                <field name="queue_sync_date" />
                <field name="sh_current_state" />
                <!-- TODO: Remove below field -->
                <field name="sh_current_config" />
                <field name="sh_note" />
            </list>
        </field>
    </record>

    <!-- ORDER -->
    <record id='sh_zid_order_tree' model='ir.ui.view'>
        <field name="name">sh.zid.order.tree</field>
        <field name="model">sh.zid.queue</field>
        <field name="arch" type="xml">
            <list decoration-success="sh_current_state=='done'" decoration-danger="sh_current_state=='error'">
                <field name="sh_queue_name" />
                <field name="sh_order_id" />
                <field name="queue_sync_date" />
                <field name="sh_current_state" />
                <field name="sh_note" />
            </list>
        </field>
    </record>

    <!-- =========================== SEARCH VIEW =========================== -->
    <record id="sh_zid_customer_queue_search_view" model="ir.ui.view">
        <field name="name">zid.customer.queue.search.view</field>
        <field name="model">sh.zid.queue</field>
        <field name="arch" type="xml">
            <search string="Zid Queue">
                <field name="sh_queue_name" />
                <field name="sh_customer_id" />
                <field name="sh_product_id" />
                <field name="sh_order_id" />
                <field name="sh_current_state" />
                <separator />
                <filter string="Draft" name="draft" domain="[('sh_current_state', '=', 'draft')]" />
                <filter string="Done" name="done" domain="[('sh_current_state', '=', 'done')]" />
                <filter string="Error" name="error" domain="[('sh_current_state', '=', 'error')]" />
                <group name="group" string="Group By">
                    <filter name="status_filter" string="Status" context="{'group_by':'sh_current_state'}" />
                </group>
            </search>
        </field>
    </record>

    <!-- =========================== ACTION =========================== -->

    <record id="sh_zid_order_queue_action" model="ir.actions.act_window">
        <field name="name">Order Queue</field>
        <field name="res_model">sh.zid.queue</field>
        <field name="domain">[
            ('queue_type', '=', 'sale_order'),
            ('sh_order_id', '!=', False)
        ]</field>
        <field name="context">{'search_default_draft': 1, 'create': False}</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="sh_zid_connector.sh_zid_order_tree" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Order Queue
            </p>
        </field>
    </record>

    <record id="sh_zid_product_queue_action" model="ir.actions.act_window">
        <field name="name">Product Queue</field>
        <field name="res_model">sh.zid.queue</field>
        <field name="domain">[
            ('queue_type', '=', 'product'),
            ('sh_product_id', '!=', False)
        ]</field>
        <field name="context">{'search_default_draft': 1, 'create': False}</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="sh_zid_connector.sh_zid_product_tree" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Product Queue
            </p>
        </field>
    </record>

    <record id="sh_zid_customer_queue_action" model="ir.actions.act_window">
        <field name="name">Customer Queue</field>
        <field name="res_model">sh.zid.queue</field>
        <field name="domain">[
            ('queue_type', '=', 'customer'),
            ('sh_customer_id', '!=', False)
        ]</field>
        <field name="context">{'search_default_draft': 1, 'create': False}</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="sh_zid_connector.sh_zid_customer_tree" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Customer Queue
            </p>
        </field>
    </record>

</odoo>